import numpy as np
import pandas as pd
import pyarrow.parquet as pq

FILE1 = "file1.parquet"
FILE2 = "file2.parquet"

KEY_COLS = ["BUCKET_SEX_COUNT", "c98"]
CF_COLS = [str(i) for i in range(0, 1213)] 

ATOL = 1e-6
RTOL = 0.0


def load_row_sums(path: str) -> pd.DataFrame:
    available = set(pq.read_schema(path).names)
    cf = [c for c in CF_COLS if c in available]
    missing = [c for c in CF_COLS if c not in available]
    if missing:
        print(f"WARNING: {path} is missing {len(missing)} cash-flow columns, e.g. {missing[:5]}")

    df = pd.read_parquet(path, columns=KEY_COLS + cf)
    out = df[KEY_COLS].copy()
    out["row_sum"] = np.nansum(df[cf].to_numpy(dtype="float64"), axis=1)
    del df
    return out


s1 = load_row_sums(FILE1)
s2 = load_row_sums(FILE2)

merged = s1.merge(s2, on="c98", how="outer", suffixes=("_1", "_2"), indicator=True)

only_one = merged[merged["_merge"] != "both"]
if not only_one.empty:
    print(f"{len(only_one)} c98 values exist in only one file:")
    print(only_one[["BUCKET_SEX_COUNT_1", "BUCKET_SEX_COUNT_2", "c98", "_merge"]].to_string(index=False))
    print()

both = merged[merged["_merge"] == "both"]
diff_mask = ~np.isclose(both["row_sum_1"], both["row_sum_2"], rtol=RTOL, atol=ATOL)
diffs = both.loc[diff_mask].copy()
diffs["BUCKET_SEX_COUNT"] = diffs["BUCKET_SEX_COUNT_1"]
diffs["difference"] = diffs["row_sum_1"] - diffs["row_sum_2"]

print(f"Rows with different sums: {len(diffs)} of {len(both)}")
pd.set_option("display.max_rows", None)
print(diffs[["BUCKET_SEX_COUNT", "c98"]].to_string(index=False))
