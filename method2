import math

import numpy as np

from .. import common
from ..common import MethodResult, PatternRow, RowBlock, TableBlock

CODE = "M2"
NAME = "Method 2 - paid to best estimate"


def run(data, settings):
    s = settings.method2
    n_acc, n_dev = data.n_accident, data.n_development

    best_estimate = data.best_estimate
    paid_in_period = data.incremental_paid()

    opening_be = np.full_like(best_estimate, np.nan)
    opening_be[:, 1:] = best_estimate[:, :-1]
    valid = ~np.isnan(paid_in_period) & ~np.isnan(opening_be) & (opening_be != 0)
    valid[:, 0] = False
    ratio = np.where(valid, paid_in_period / np.where(valid, opening_be, 1.0), np.nan)

    payment_position = data.accident_position[:, None] + np.arange(n_dev)[None, :]
    periods_with_data = np.unique(payment_position[valid])
    if s.payment_periods:
        periods_used = periods_with_data[-s.payment_periods:]
    else:
        periods_used = periods_with_data
    in_window = valid & np.isin(payment_position, periods_used)
    ratio_used = np.where(in_window, ratio, np.nan)

    n_obs = in_window.sum(axis=0)
    q = np.full(n_dev, np.nan)
    for k in range(1, n_dev):
        if n_obs[k] > 0:
            q[k] = np.nanmean(ratio_used[:, k])

    chain = [s.pi_1]
    for k in range(1, n_dev):
        if np.isnan(q[k]):
            break
        chain.append(chain[-1] + (1 - chain[-1]) * q[k])
    x1 = len(chain)
    y1 = chain[-1]

    best_estimate_latest = np.nan_to_num(data.latest_diagonal(best_estimate))
    rule_x2, oldest_open = common.end_tenor_rule(data, best_estimate_latest, s.open_threshold)
    x2 = s.end_tenor_override or rule_x2

    a, c = common.log_curve_through_points(x1, y1, x2, log=math.log)
    n_tenors = max(x1 + 1, x2, n_dev)
    pattern = np.ones(n_tenors)
    for t in range(1, n_tenors + 1):
        if t <= x1:
            pattern[t - 1] = chain[t - 1]
        elif t >= x2:
            pattern[t - 1] = 1.0
        else:
            pattern[t - 1] = a * math.log(t) + c

    tenors = list(range(1, n_tenors + 1))
    tenor_labels = list(range(1, n_dev + 1))
    q_by_tenor = np.full(n_tenors, np.nan)
    q_by_tenor[:n_dev] = q
    n_by_tenor = np.full(n_tenors, np.nan)
    n_by_tenor[1:n_dev] = n_obs[1:]
    first_label = data.period_labels[int(periods_used[0])] if len(periods_used) else "n/a"
    last_label = data.period_labels[int(periods_used[-1])] if len(periods_used) else "n/a"
    blocks = [
        TableBlock("best estimate (rbns + ibnr) at the end of each development period:", data.accident_labels,
                   list(range(n_dev)), best_estimate, "number", is_input=True),
        TableBlock("paid within each development period:", data.accident_labels, list(range(n_dev)),
                   paid_in_period, "number", is_input=True),
        TableBlock("payout ratio triangle: paid in tenor t / BE at end of tenor t-1 (window only):",
                   data.accident_labels, tenor_labels, ratio_used, "percent1"),
        RowBlock("run-off:", tenors, [
            PatternRow("number of observations n_t", n_by_tenor, "integer"),
            PatternRow("expected payout rate q_t (simple average)", q_by_tenor, "percent1"),
            PatternRow("pattern from data", common.pad_to(np.array(chain), n_tenors)),
            PatternRow("final pattern (copy this row)", pattern, highlight=True),
            PatternRow("implied one-year payout", common.implied_payout_rates(pattern), "percent1"),
        ]),
    ]
    parameters = [
        ("pi_1 (set by hand)", s.pi_1, "percent"),
        ("payment periods used", f"{first_label} - {last_label} ({len(periods_used)})", "text"),
        ("x1 = last tenor with data", x1, "integer"),
        ("y1 = pattern at x1", y1, "percent"),
        ("latest accident period", data.accident_labels[-1], "text"),
        ("oldest accident period with BE > threshold", oldest_open, "text"),
        ("x2 by rule = (latest + 1 - oldest open) + 2", rule_x2, "integer"),
        ("x2 used", x2, "integer"),
        ("a  (y = a*ln(t) + c)", a, "decimal"),
        ("c", c, "decimal"),
    ]
    return MethodResult(CODE, NAME, data.name,
                        "Simple average of paid / opening BE by tenor, chained from pi_1, ln tail to 100% at x2.",
                        pattern, blocks, parameters)
