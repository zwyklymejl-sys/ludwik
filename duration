import os

import numpy as np
import xlsxwriter

from . import config
from .excel_writer import Formats, sheet_names_for, write_value

DISCOUNT_RATE = 0.0
PERIODS_PER_YEAR = 1
OUTPUT_DURATION_COMPARISON = "output_duration_comparison.xlsx"

_COLLECTED = []

def _pattern_value(pattern, tenor):
    if tenor <= len(pattern):
        return pattern[tenor - 1]
    return 1.0


def project(data, pattern):
    tenor_at_v = data.latest_position - data.accident_position + 1
    paid_at_v = np.nan_to_num(data.latest_diagonal(data.paid))
    be_at_v = np.nan_to_num(data.latest_diagonal(data.best_estimate))

    horizon = max(1, len(pattern) - int(tenor_at_v.min()))
    cash_flows = np.zeros((data.n_accident, horizon))
    for i in range(data.n_accident):
        t = int(tenor_at_v[i])
        pi_t = _pattern_value(pattern, t)
        if be_at_v[i] == 0:
            continue
        if pi_t >= 1:
            cash_flows[i, 0] = be_at_v[i]
            continue
        for h in range(1, horizon + 1):
            step = _pattern_value(pattern, t + h) - _pattern_value(pattern, t + h - 1)
            cash_flows[i, h - 1] = be_at_v[i] * step / (1 - pi_t)
    return cash_flows, tenor_at_v, paid_at_v, be_at_v


def duration(cash_flows):
    total = float(np.sum(cash_flows))
    if total == 0:
        return None
    times = (np.arange(1, len(cash_flows) + 1) - 0.5) / PERIODS_PER_YEAR
    discount = (1 + DISCOUNT_RATE) ** (-times)
    present_value = cash_flows * discount
    return float(np.sum(present_value * times) / np.sum(present_value))


def completed_triangle(data, tenor_at_v, paid_at_v, cash_flows):
    n_dev = max(data.n_development, int(tenor_at_v.max()) + cash_flows.shape[1])
    triangle = np.full((data.n_accident, n_dev), np.nan)
    triangle[:, :data.n_development] = data.paid
    is_projected = np.zeros_like(triangle, dtype=bool)
    for i in range(data.n_accident):
        k_v = int(tenor_at_v[i]) - 1
        running = paid_at_v[i]
        for h in range(1, cash_flows.shape[1] + 1):
            k = k_v + h
            if k >= n_dev:
                break
            running += cash_flows[i, h - 1]
            triangle[i, k] = running
            is_projected[i, k] = True
    return triangle, is_projected


def collect(known, results):
    _COLLECTED.append((known, results))


def write_outputs(output_folder):
    if not _COLLECTED:
        return
    sheet_names = sheet_names_for([known.name for known, _ in _COLLECTED])
    rows = []
    methods = [r.method_code for r in _COLLECTED[0][1]]
    for code in methods:
        name = config.OUTPUT_METHOD_FILES[code].replace("output_", "output_projection_", 1)
        path = os.path.join(output_folder, name)
        book = xlsxwriter.Workbook(path, {"nan_inf_to_errors": True})
        f = _formats(book)
        projected_fmt = book.add_format({"font_name": "Arial", "font_size": 10, "num_format": "#,##0",
                                         "bg_color": "#E2EFDA"})
        for known, results in _COLLECTED:
            result = next(r for r in results if r.method_code == code)
            cash_flows, tenor_at_v, paid_at_v, be_at_v = project(known, result.pattern)
            triangle, is_projected = completed_triangle(known, tenor_at_v, paid_at_v, cash_flows)
            total_flows = cash_flows.sum(axis=0)
            total_duration = duration(total_flows)
            rows.append({"aggregate": known.name, "valuation": known.period_labels[known.latest_position],
                         "method": result.method_name, "BE": float(be_at_v.sum()),
                         "projected": float(cash_flows.sum()), "duration": total_duration,
                         "flows": total_flows})
            _write_projection_sheet(book.add_worksheet(sheet_names[known.name]), f, projected_fmt, known,
                                    triangle, is_projected, cash_flows, be_at_v, total_duration)
        book.close()
        print(f"written {path}")
    path = os.path.join(output_folder, OUTPUT_DURATION_COMPARISON)
    _write_duration_comparison(path, rows)
    print(f"written {path}")
    _COLLECTED.clear()

def _formats(book):
    f = Formats(book)
    base = {"font_name": "Arial", "font_size": 10, "num_format": "0.00"}
    f.value[("decimal2", "calc")] = book.add_format(base)
    f.value[("decimal2", "highlight")] = book.add_format({**base, "bg_color": "#FFFF00"})
    return f


def _write_projection_sheet(sheet, f, projected_fmt, data, triangle, is_projected, cash_flows, be_at_v,
                            total_duration):
    labels = data.accident_labels
    n_dev = triangle.shape[1]
    row = 0
    sheet.write_string(row, 0, "cumulative paid (projected cells shaded)", f.bold)
    row += 1
    sheet.write_string(row, 0, "accident \\ development", f.header)
    for k in range(n_dev):
        sheet.write_number(row, 1 + k, k, f.header)
    for i, label in enumerate(labels):
        row += 1
        sheet.write_string(row, 0, label, f.bold)
        for k in range(n_dev):
            fmt = projected_fmt if is_projected[i, k] else f.cell("number", "input")
            write_value(sheet, row, 1 + k, triangle[i, k], fmt)
    row += 3

    horizon = cash_flows.shape[1]
    sheet.write_string(row, 0, "projected payments", f.bold)
    row += 1
    sheet.write_string(row, 0, "accident \\ period", f.header)
    for h in range(horizon):
        sheet.write_string(row, 1 + h, f"V+{h + 1}", f.header)
    for j, header in enumerate(["total", "BE at valuation", "duration (years)"]):
        sheet.write_string(row, 1 + horizon + j, header, f.header)
    for i, label in enumerate(labels):
        row += 1
        sheet.write_string(row, 0, label, f.bold)
        for h in range(horizon):
            if cash_flows[i, h] != 0:
                sheet.write_number(row, 1 + h, cash_flows[i, h], f.cell("number"))
        write_value(sheet, row, 1 + horizon, cash_flows[i].sum(), f.cell("number"))
        write_value(sheet, row, 2 + horizon, be_at_v[i], f.cell("number", "input"))
        write_value(sheet, row, 3 + horizon, duration(cash_flows[i]), f.cell("decimal2"))
    row += 1
    sheet.write_string(row, 0, "total", f.highlight_label)
    for h in range(horizon):
        write_value(sheet, row, 1 + h, cash_flows[:, h].sum(), f.cell("number", "highlight"))
    write_value(sheet, row, 1 + horizon, cash_flows.sum(), f.cell("number", "highlight"))
    write_value(sheet, row, 2 + horizon, be_at_v.sum(), f.cell("number", "highlight"))
    write_value(sheet, row, 3 + horizon, total_duration, f.cell("decimal2", "highlight"))
    sheet.set_column(0, 0, 24)
    sheet.set_column(1, max(n_dev, horizon + 3) + 1, 11)
    sheet.freeze_panes(2, 1)


def _write_duration_comparison(path, rows):
    book = xlsxwriter.Workbook(path, {"nan_inf_to_errors": True})
    f = _formats(book)
    # sheet 1: duration per aggregate x method
    sheet = book.add_worksheet("Duration")
    headers = ["aggregate", "valuation", "method", "BE at valuation", "projected payments", "duration (years)"]
    if DISCOUNT_RATE:
        headers.append("modified duration")
    for j, h in enumerate(headers):
        sheet.write_string(0, j, h, f.header)
    for r, item in enumerate(rows, start=1):
        sheet.write_string(r, 0, str(item["aggregate"]), f.text)
        sheet.write_string(r, 1, str(item["valuation"]), f.text)
        sheet.write_string(r, 2, item["method"], f.text)
        write_value(sheet, r, 3, item["BE"], f.cell("number"))
        write_value(sheet, r, 4, item["projected"], f.cell("number"))
        write_value(sheet, r, 5, item["duration"], f.cell("decimal2"))
        if DISCOUNT_RATE and item["duration"] is not None:
            write_value(sheet, r, 6, item["duration"] / (1 + DISCOUNT_RATE), f.cell("decimal2"))
    sheet.set_column(0, 0, 40)
    sheet.set_column(1, 1, 11)
    sheet.set_column(2, 2, 34)
    sheet.set_column(3, 6, 18)
    sheet.freeze_panes(1, 3)

    horizon = max(len(item["flows"]) for item in rows)
    sheet = book.add_worksheet("Cash flows")
    for j, h in enumerate(["aggregate", "valuation", "method"] + [f"V+{h + 1}" for h in range(horizon)] + ["total"]):
        sheet.write_string(0, j, h, f.header)
    for r, item in enumerate(rows, start=1):
        sheet.write_string(r, 0, str(item["aggregate"]), f.text)
        sheet.write_string(r, 1, str(item["valuation"]), f.text)
        sheet.write_string(r, 2, item["method"], f.text)
        for h, value in enumerate(item["flows"]):
            write_value(sheet, r, 3 + h, value, f.cell("number"))
        write_value(sheet, r, 3 + horizon, float(np.sum(item["flows"])), f.cell("number"))
    sheet.set_column(0, 0, 40)
    sheet.set_column(1, 1, 11)
    sheet.set_column(2, 2, 34)
    sheet.set_column(3, horizon + 3, 11)
    sheet.freeze_panes(1, 3)
    book.close()
